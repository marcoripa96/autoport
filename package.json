{
  "name": "@mr96/autoport",
  "version": "0.3.0",
  "description": "Automatic, conflict-free port allocation for local dev stacks.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcoripa96/autoport.git"
  },
  "homepage": "https://github.com/marcoripa96/autoport#readme",
  "bugs": {
    "url": "https://github.com/marcoripa96/autoport/issues"
  },
  "bin": {
    "autoport": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "edge-light": "./dist/browser.js",
      "worker": "./dist/browser.js",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "skill-data"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./src/index.ts ./src/config.ts ./src/browser.ts ./src/cli.ts --outdir dist --target node --format esm --external yaml && tsc --emitDeclarationOnly",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepack": "bun test && bun run build"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "peerDependencies": {
    "portless": ">=0.15"
  },
  "peerDependenciesMeta": {
    "portless": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "port",
    "ports",
    "dev",
    "docker-compose",
    "monorepo",
    "worktree"
  ],
  "browser": {
    "./dist/index.js": "./dist/browser.js"
  }
}
